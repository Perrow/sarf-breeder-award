#!/usr/bin/env bash
set -euo pipefail

if [[ ! -f .venv/bin/activate ]]; then
    echo "Hittar inte .venv/bin/activate. Skapa miljön med: python -m venv .venv" >&2
    exit 1
fi

if [[ ! -f .env ]]; then
    echo "Hittar inte .env. Skapa den enligt docs/mariadb.md." >&2
    exit 1
fi

source .venv/bin/activate
set -a
source .env
set +a

git pull
python manage.py migrate
./mariadbtest
